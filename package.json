{
  "name": "arrol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-secrets.mjs && node scripts/prisma-generate.mjs && node scripts/migrate-if-configured.mjs && next build && node scripts/check-client-bundle.mjs",
    "start": "next start",
